# DVC manages its own .gitignore entries inside RawData/, data/, results/,
# reference/, MaxQuantSearch/ (per-file, added automatically by `dvc add`) —
# do not blanket-ignore those directories here, or DVC's pointer (.dvc)
# files would be ignored too.

# Installed third-party tools (MaxQuant, ThermoRawFileParser) — large binaries,
# redownloaded via documented steps rather than version-controlled.
/tools/

# MaxQuant run logs and generated output (DVC-tracked once a run completes,
# or just regenerable) — but keep mqpar.xml itself, it's the versioned config.
MaxQuantSearch/*/run.log
MaxQuantSearch/*/combined/
MaxQuantSearch/*/txt/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# R
.Rhistory
.RData
.Rproj.user/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
/reference
